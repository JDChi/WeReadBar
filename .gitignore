# Xcode — build output (DerivedData lives in ~/Library/Developer by default,
# but a local build/ folder would also be ignored)
build/
DerivedData/
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager
.build/
Packages/
Package.pins
Package.resolved
.swiftpm/

# Local Claude Code config (not for version control)
.claude/

# Build artifacts produced by scripts/build-dmg.sh — never commit DMGs
# or the staging directory; only push them via the GitHub Actions release.
*.dmg
build/dmg-staging/
dist/

# IDE
.vscode/
.idea/
*.swp
