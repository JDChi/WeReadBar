    "onboarding.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paste the bearer token from i.weread.qq.com. It’s stored in the macOS Keychain and only ever read by this app."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请粘贴 i.weread.qq.com 上的 bearer token。它存储在 macOS 钥匙串中，仅本应用可读取。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請貼上 i.weread.qq.com 上的 bearer token。它儲存在 macOS 鑰匙圈中，僅本應用可讀取。"
          }
        }
      }
